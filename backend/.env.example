# ===== 存储位置(默认全在 D 盘,不用改) =====
# 模型文件目录(Ollama 大模型、HuggingFace 嵌入/重排模型)
# AI_MODELS_DIR=D:/AIModels
# 项目运行数据(数据库、向量库、上传文件)
# DATA_DIR=D:/langchain-data

# ===== 大模型配置 =====
# local = 本地 Ollama(免费,答辩断网也能用,推荐)
# api   = DeepSeek API(效果好,需要联网花钱)
LLM_PROVIDER=local
OLLAMA_MODEL=qwen3:32b
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===== 嵌入/重排模型(本地 HuggingFace,国内自动走镜像) =====
HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 安全 =====
SECRET_KEY=dev-secret-change-me
JWT_EXPIRE_MINUTES=10080

# ===== 预置管理员 =====
ADMIN_USER=admin
ADMIN_PASSWORD=123456
